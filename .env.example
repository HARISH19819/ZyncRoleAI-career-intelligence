# ZyncRole AI - Environment Variables Configuration

# ----------------------------------------------------
# APPLICATION ENVIRONMENT
# ----------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ----------------------------------------------------
# DATABASE (Supabase PostgreSQL + pgvector)
# Fallback to local SQLite during offline/local testing
# ----------------------------------------------------
# Format for Supabase Postgres:
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=sqlite+aiosqlite:///./zyncrole.db

# Supabase Auth & Storage Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for local dev / fallback auth
JWT_SECRET=super-secret-zyncrole-jwt-key-minimum-32-chars-hackathon-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------
# AI & MACHINE LEARNING (Google Gemini API)
# ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ----------------------------------------------------
# EXTERNAL ATS RESUME BUILDER
# ----------------------------------------------------
ATS_RESUME_BUILDER_URL=https://www.open-resume.com

# ----------------------------------------------------
# JOB DISCOVERY SOURCES (Free Tier / Official API Keys)
# Keep empty to use seed/demo dataset or gated mock mode
# ----------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

JOOBLE_API_KEY=

THE_MUSE_API_KEY=

REMOTIVE_API_ENABLED=false

# Gated platforms (only active when authorized API credentials provided)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
NAUKRI_API_KEY=
INTERNSHALA_API_KEY=

# Internal ingestion webhook / automated trigger secret
INTERNAL_INGESTION_SECRET=zyncrole-secure-internal-ingestion-token-2026

# ----------------------------------------------------
# FRONTEND PUBLIC CONFIG (Vite prefix: VITE_)
# ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ATS_RESUME_BUILDER_URL=https://www.open-resume.com
